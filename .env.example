# Copy to .env (never commit .env). Values here are placeholders.

# --- LLM ---
GOOGLE_API_KEY=your-key-here
SKILLBRIDGE_MODEL=google_genai:gemini-2.5-flash-lite
# Optional: a different model for the LLM judge (fairer than a model grading itself)
# SKILLBRIDGE_JUDGE_MODEL=google_genai:gemini-2.5-flash
# Optional: price per 1M tokens (input, output) if your model isn't in app/core/tracing.py
# SKILLBRIDGE_PRICE_IN=0.10
# SKILLBRIDGE_PRICE_OUT=0.40

# --- Web demo ---
DEMO_ACCESS_CODE=choose-a-long-random-code
DAILY_BUDGET_USD=1.0
RATE_LIMIT_PER_HOUR=10
SESSION_TTL_MINUTES=30
MAX_SESSIONS=200
MAX_JD_CHARS=15000
TRUST_PROXY=false
ENABLE_DOCS=false
LOG_LEVEL=INFO
